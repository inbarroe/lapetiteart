# Copy this file to .env.local and fill in the values.
# .env.local is ignored by git — never commit real keys.
# On Vercel, set the same variables under Project → Settings → Environment Variables.

# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Resend → API Keys
RESEND_API_KEY=
# Where new-request notifications are sent
NOTIFY_EMAIL=
# Protects /api/keepalive, the daily Vercel Cron job that keeps Supabase awake.
# Any long random string, e.g. from: node -e "console.log(crypto.randomUUID())"
CRON_SECRET=

# Optional until a domain is verified in Resend
# EMAIL_FROM="La Petite Art <hello@your-domain>"
